# Optional, but set it before you show this to anyone.
#
# Without a token GitHub allows 60 API requests an hour from your server's IP,
# and mapping one repository spends two of them. A token with NO scopes ticked
# (public read only) raises the ceiling to 5,000 an hour.
#
# Make one at https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Required before Codarc can draft changes. Without it the map still works,
# but "Draft the change" returns a clear "not set up yet" message.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. While Codarc is pre-launch, set this to lock "Draft the change" to
# you alone — every draft costs real money and you don't want a stranger
# spending it. Make it long and random.
#
# Unlock yourself once by visiting:
#   https://your-domain/api/unlock?key=THE-SAME-VALUE
#
# Leave it empty and drafting is open to everyone.
CODARC_OWNER_KEY=

# --- Sign in with GitHub -----------------------------------------------
# From the same GitHub App page. The client secret is only needed for
# sign-in; repo access uses the private key above.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Signs the session cookie. Any long random string. Change it and everyone
# is signed out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Supabase (the database) -------------------------------------------
# Remembers who's paying, counts projects and changes, and holds teams.
# Supabase → Project Settings → API. Use the *service_role* key, never the
# anon one. It stays on the server; the browser never sees it.
# Run supabase/schema.sql once in the SQL editor before this does anything.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# For live cursors on Studio. This one IS safe to be public — it's the "anon"
# key from the same page. Every table has RLS with no policies, so it can't
# read any data; it only opens the realtime connection. Codarc hands it out
# only to Studio users, along with a channel name nobody else can guess.
SUPABASE_ANON_KEY=

# --- Payments (Lemon Squeezy) --------------------------------------------
# See SETUP-PAYMENTS.md. Lemon Squeezy takes the card, handles sales tax,
# and pays out to your bank. Start with the TEST MODE key; swap to the live
# key once the store is activated.
LEMONSQUEEZY_API_KEY=
# Any long random string — type the same one into Lemon Squeezy's webhook.
LEMONSQUEEZY_WEBHOOK_SECRET=
# The next three come from https://your-domain/api/billing/setup once the
# API key is in (owner key required).
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_SOLO_VARIANT_ID=
LEMONSQUEEZY_STUDIO_VARIANT_ID=
